{
    "name": "fa-design-system",
    "version": "0.2.0",
    "description": "The Fa Design System: React components built with Tailwind CSS and React Aria, kept in sync with the Fa Design System Figma file.",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        "./components/base/avatar/base-components": {
            "types": "./dist/components/base/avatar/base-components/index.d.ts",
            "import": "./dist/components/base/avatar/base-components/index.js"
        },
        "./components/foundations/payment-icons": {
            "types": "./dist/components/foundations/payment-icons/index.d.ts",
            "import": "./dist/components/foundations/payment-icons/index.js"
        },
        "./components/foundations/social-icons": {
            "types": "./dist/components/foundations/social-icons/index.d.ts",
            "import": "./dist/components/foundations/social-icons/index.js"
        },
        "./components/shared-assets/background-patterns": {
            "types": "./dist/components/shared-assets/background-patterns/index.d.ts",
            "import": "./dist/components/shared-assets/background-patterns/index.js"
        },
        "./components/shared-assets/illustrations": {
            "types": "./dist/components/shared-assets/illustrations/index.d.ts",
            "import": "./dist/components/shared-assets/illustrations/index.js"
        },
        "./components/*": {
            "types": "./dist/components/*.d.ts",
            "import": "./dist/components/*.js"
        },
        "./hooks/*": {
            "types": "./dist/hooks/*.d.ts",
            "import": "./dist/hooks/*.js"
        },
        "./utils/*": {
            "types": "./dist/utils/*.d.ts",
            "import": "./dist/utils/*.js"
        },
        "./styles/*": "./styles/*",
        "./eslint": "./eslint/index.mjs",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "components",
        "hooks",
        "utils",
        "styles",
        "skills",
        "eslint",
        "docs/figma-parity.md",
        "docs/overrides.md",
        "docs/icons.md",
        "TOKENS.md",
        "CLAUDE.md",
        "scripts/setup.mjs",
        "!**/*.story.tsx",
        "!**/*.demo.tsx",
        "!components/internal"
    ],
    "bin": {
        "fa-design-system": "scripts/setup.mjs"
    },
    "scripts": {
        "storybook": "storybook dev -p 6006 --no-open",
        "build-storybook": "storybook build -o ./storybook-static",
        "sandbox": "storybook dev -c .storybook-sandbox -p 6008 --no-open",
        "sandbox:build": "storybook build -c .storybook-sandbox -o ./sandbox-static",
        "sandbox:check": "tsc --noEmit -p sandbox/tsconfig.json && prettier --check sandbox --ignore-path .gitignore && eslint -c eslint.sandbox.config.mjs sandbox/pages",
        "lint": "eslint components --fix",
        "lint:check": "eslint components",
        "prettier": "prettier . --write",
        "prettier:check": "prettier . --check",
        "type-check": "tsc --noEmit",
        "tokens:check": "node scripts/check-token-parity.mjs",
        "test": "npm run type-check && npm run lint:check && npm run prettier:check && npm run tokens:check && npm run skill:check",
        "build": "node scripts/build-package.mjs",
        "prepare": "node scripts/build-package.mjs",
        "skill:check": "node scripts/check-skill.mjs",
        "layout:check": "node scripts/check-layout.mjs"
    },
    "keywords": [
        "react",
        "components",
        "tailwind",
        "ui",
        "design-system",
        "typescript"
    ],
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/m-kolovrat/fa-design-system/issues"
    },
    "homepage": "https://fa-design-system-mkolovrat-proficohrs-projects.vercel.app",
    "repository": {
        "type": "git",
        "url": "https://github.com/m-kolovrat/fa-design-system.git"
    },
    "dependencies": {
        "@internationalized/date": "^3.12.3",
        "@react-aria/utils": "^3.34.1",
        "@react-stately/utils": "^3.12.1",
        "@tailwindcss/typography": "^0.5.20",
        "@untitledui/file-icons": "^0.0.9",
        "embla-carousel-react": "^8.6.0",
        "fa-icons": "github:m-kolovrat/fa-icons#v0.2.0",
        "input-otp": "^1.4.2",
        "motion": "^12.42.2",
        "qr-code-styling": "^1.9.2",
        "react-aria": "^3.51.0",
        "react-aria-components": "^1.20.0",
        "react-hook-form": "^7.82.0",
        "recharts": "^3.10.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-react-aria-components": "^2.2.0",
        "zod": "^4.4.3"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwindcss": "^4.3.0"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^5.2.1",
        "@eslint/eslintrc": "^3.3.6",
        "@storybook/addon-docs": "^10.5.3",
        "@storybook/addon-themes": "^10.5.3",
        "@storybook/nextjs-vite": "10.5.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/vite": "^4.3.3",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "@vitejs/plugin-react": "^6.0.4",
        "eslint": "^10.7.0",
        "eslint-config-next": "^16.3.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-storybook": "10.5.3",
        "eslint-plugin-tailwindcss": "^4.2.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "next": "^16.3.0",
        "next-themes": "^0.4.6",
        "postcss": "^8.5.21",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "storybook": "^10.5.3",
        "tailwindcss": "^4.3.3",
        "tsc-alias": "^1.9.9",
        "typescript": "^5.9.3",
        "vite": "^8.1.5"
    }
}
